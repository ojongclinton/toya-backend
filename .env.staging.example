# Compose identity: never reuse the production project name or network alias.
ENV_FILE=.env.staging
COMPOSE_PROJECT_NAME=toya-staging
TOYA_API_ALIAS=toya-api-staging
CELERY_CONCURRENCY=1

# Staging hostname
DOMAIN=staging-api.toya-vtc.com

# Django
DJANGO_SECRET=generate_a_staging_only_random_secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=staging-api.toya-vtc.com
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_LOG_LEVEL=INFO
CSRF_TRUSTED_ORIGINS=https://staging-api.toya-vtc.com
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://staging-dashboard.example.com
TIME_ZONE=Africa/Douala
ENABLE_TESTING_ENDPOINTS=False
ENFORCE_PHONE_VERIFICATION=False
ENABLE_OTP_THROTTLING=True

# Staging-only PostgreSQL credentials and volume/container
POSTGRES_DB=toya_staging
POSTGRES_USER=toya_staging
POSTGRES_PASSWORD=generate_a_staging_only_database_password
DB_NAME=toya_staging
DB_USER=toya_staging
DB_PASSWORD=generate_a_staging_only_database_password
DB_HOST=postgres
DB_PORT=5432

# Staging-only Redis credentials and volume/container
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=generate_a_staging_only_redis_password

# Use a separate Firebase project/service account for staging.
FIREBASE_CREDENTIALS=/run/secrets/firebase-service-account.json

# Keep real SMS disabled by leaving these empty, or use test credentials.
SMS_USER=
SMS_PASSWORD=
SMS_SENDER_ID=TOYA-STAGING

# Staging/sandbox payment credentials only.
S3P_KEY=
S3P_SECRET=
BASE_API_URL=https://s3p.smobilpay.staging.maviance.info/v2/
SMOBIL_PAY_API_DEBUG=True

GOOGLE_API_KEY=

# Use a test mailbox or leave SMTP disabled.
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
