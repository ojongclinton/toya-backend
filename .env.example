# ============================================================================
# ELYFT TOYA Backend - Environment Variables Example
# ============================================================================
# Copy this file to .env and fill in your actual values
# Never commit .env to version control!

# Django Settings
DJANGO_SECRET=replace_with_a_unique_random_secret

# Database Configuration
DB_NAME=toya_db
DB_USER=toya
DB_PASSWORD=replace_with_a_unique_random_password
DB_HOST=localhost
DB_PORT=5432

# SMS Service Configuration
SMS_USER=your_sms_username
SMS_PASSWORD=your_sms_password
SMS_SENDER_ID=TOYA

S3P_KEY=add_key
S3P_SECRET=add_secret
BASE_API_URL=https://s3pv2cm.smobilpay.com/v2/

S3P_KEY_DEV=add_key_dev
S3P_SECRET_DEV=add_secret_dev
BASE_API_URL_DEV=https://s3p.smobilpay.staging.maviance.info/v2/

# Google API
GOOGLE_API_KEY=your_google_api_key

# ============================================================================
# FEATURE FLAGS
# ============================================================================

# OTP Phone Verification
# Set to 'true' to require phone verification before login
# Set to 'false' for legacy behavior (immediate token issuance)
ENFORCE_PHONE_VERIFICATION=false

# OTP Throttling
# Set to 'true' to enable rate limiting on OTP endpoints
# Set to 'false' to disable throttling (useful for testing)
ENABLE_OTP_THROTTLING=true

# ============================================================================
# ⚠️ TESTING ENDPOINTS - CRITICAL SECURITY SETTING ⚠️
# ============================================================================
# Controls access to destructive testing/development endpoints
# 
# When TRUE: Enables endpoints that can:
#   - Delete user accounts permanently
#   - Reset accounts (clear all data)
#   - Adjust driver wallet balances
#
# When FALSE (default): All testing endpoints return 403 Forbidden
#
# 🔴 MUST BE FALSE IN PRODUCTION 🔴
# Only enable in local development or isolated testing environments
#
# Affected endpoints:
#   POST /clients/dev/reset/
#   DELETE /clients/delete/
#   POST /drivers/dev/reset/
#   POST /drivers/dev/adjust-wallet/
#   DELETE /drivers/delete/
#
ENABLE_TESTING_ENDPOINTS=false

# ============================================================================
# DEPLOYMENT CHECKLIST FOR PRODUCTION
# ============================================================================
# Before deploying to production, ensure:
# ✅ DEBUG=False in settings.py
# ✅ ENABLE_TESTING_ENDPOINTS=false (or not set)
# ✅ Strong DJANGO_SECRET value
# ✅ Secure database credentials
# ✅ ALLOWED_HOSTS properly configured
# ✅ SSL/HTTPS enabled
