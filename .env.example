# =============================================================================
# TOYA BACKEND - ENVIRONMENT VARIABLE TEMPLATE
# =============================================================================
# Production: copy this file to .env.production and replace every CHANGE_ME.
# Local development: copy it to .env and change Docker hostnames as needed.
#
# Never commit a populated .env or .env.production file.
# Never place the Firebase service-account JSON contents in this file.

# =============================================================================
# 1. DEPLOYMENT IDENTITY (Docker Compose)
# =============================================================================
# These values isolate the production Compose project, image, volumes and
# gateway hostname. The defaults in docker-compose.prod.yml match these values.
ENV_FILE=.env.production
COMPOSE_PROJECT_NAME=toya-prod
TOYA_API_ALIAS=toya-api-prod
BACKEND_IMAGE=toya-backend:prod
CELERY_CONCURRENCY=2

# =============================================================================
# 2. DJANGO CORE - REQUIRED TO START
# =============================================================================
# Generate a long, unique random value. Changing it invalidates JWTs and other
# signed Django data.
DJANGO_SECRET=CHANGE_ME_LONG_RANDOM_DJANGO_SECRET

# Production must use False.
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=api.toya-vtc.com

# Reverse-proxy/HTTPS security. Caddy sends X-Forwarded-Proto to Django.
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_LOG_LEVEL=INFO

# Comma-separated URLs, without trailing slashes.
CSRF_TRUSTED_ORIGINS=https://api.toya-vtc.com
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://toya-vtc.com,https://www.toya-vtc.com

TIME_ZONE=Africa/Douala

# =============================================================================
# 3. POSTGRESQL - REQUIRED TO START
# =============================================================================
# POSTGRES_* initializes the database container. DB_* configures Django.
# Keep each matching pair identical.
POSTGRES_DB=toya_db
POSTGRES_USER=toya
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_DATABASE_PASSWORD

DB_NAME=toya_db
DB_USER=toya
DB_PASSWORD=CHANGE_ME_LONG_RANDOM_DATABASE_PASSWORD
DB_HOST=postgres
DB_PORT=5432
DB_CONN_MAX_AGE=60

# For local development outside Docker, DB_HOST will normally be localhost.

# =============================================================================
# 4. REDIS / CHANNELS / CELERY - REQUIRED TO START
# =============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_LONG_RANDOM_REDIS_PASSWORD

# REDIS_URL is an optional complete override. If it is set, Django ignores the
# three REDIS_* connection values above. Leave it unset for this Docker stack.
# REDIS_URL=redis://:CHANGE_ME@redis:6379/0

# =============================================================================
# 5. STATIC FILES AND USER-UPLOADED MEDIA
# =============================================================================
# These paths match the persistent Docker volumes and normally should not be
# changed in production.
STATIC_ROOT=/vol/static
MEDIA_ROOT=/vol/media

# =============================================================================
# 6. FIREBASE CLOUD MESSAGING - REQUIRED FOR PUSH NOTIFICATIONS
# =============================================================================
# The JSON credential is mounted as a read-only Docker secret. Store the file at
# secrets/firebase-service-account.json on the server; do not commit it.
ENABLE_FIREBASE=True
FIREBASE_CREDENTIALS=/run/secrets/firebase-service-account.json

# =============================================================================
# 7. GOOGLE MAPS - REQUIRED FOR ROUTING, DISTANCE AND GEOCODING
# =============================================================================
# The server key must be permitted to use the Directions and Geocoding APIs.
GOOGLE_API_KEY=CHANGE_ME_GOOGLE_SERVER_API_KEY

# =============================================================================
# 8. SMSVAS - REQUIRED FOR OTP AND SMS NOTIFICATIONS
# =============================================================================
# Production signup/password-reset flows cannot reliably work without these.
SMS_USER=CHANGE_ME_SMSVAS_USERNAME
SMS_PASSWORD=CHANGE_ME_SMSVAS_PASSWORD
SMS_SENDER_ID=TOYA

# =============================================================================
# 9. SMOBILPAY / MAVIANCE - REQUIRED FOR MOBILE-MONEY PAYMENTS
# =============================================================================
S3P_KEY=CHANGE_ME_SMOBILPAY_PUBLIC_KEY
S3P_SECRET=CHANGE_ME_SMOBILPAY_SECRET_KEY
BASE_API_URL=https://s3pv2cm.smobilpay.com/v2/

# This flag is read by the current payment client. It does not currently switch
# to separate development credentials or a development URL.
SMOBIL_PAY_API_DEBUG=False

# =============================================================================
# 10. SMTP EMAIL - REQUIRED FOR PASSWORD-RESET/BACK-OFFICE EMAILS
# =============================================================================
# The implementation uses SMTP over SSL; port 465 is the expected default.
EMAIL_HOST=CHANGE_ME_SMTP_HOST
EMAIL_PORT=465
EMAIL_HOST_USER=CHANGE_ME_SMTP_USERNAME
EMAIL_HOST_PASSWORD=CHANGE_ME_SMTP_PASSWORD
DEFAULT_FROM_EMAIL=CHANGE_ME_FROM_EMAIL

# =============================================================================
# 11. PRODUCTION FEATURE AND SECURITY FLAGS
# =============================================================================
# Enable mandatory phone verification only after SMS delivery has been tested.
ENFORCE_PHONE_VERIFICATION=True
ENABLE_OTP_THROTTLING=True

# CRITICAL: must remain False in production. When enabled, destructive testing
# endpoints can reset/delete accounts and adjust driver wallet balances.
ENABLE_TESTING_ENDPOINTS=False

# =============================================================================
# PRE-LAUNCH REQUIREMENTS OUTSIDE THIS FILE
# =============================================================================
# - secrets/firebase-service-account.json exists and is chmod 600.
# - api.toya-vtc.com resolves to the VPS and HTTPS is working.
# - PostgreSQL and Redis passwords are unique and not reused elsewhere.
# - Google, SMS, payment and SMTP credentials have been tested independently.
# - The unauthenticated back-office admin-registration endpoint is secured.
