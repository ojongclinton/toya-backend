# Public hostname. Create an A record pointing this name to the VPS first.
DOMAIN=api.example.com

# Django
DJANGO_SECRET=generate_a_long_unique_random_value
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=api.example.com
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_LOG_LEVEL=INFO
CSRF_TRUSTED_ORIGINS=https://api.example.com
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://dashboard.example.com
TIME_ZONE=Africa/Douala
ENABLE_TESTING_ENDPOINTS=False
ENFORCE_PHONE_VERIFICATION=False
ENABLE_OTP_THROTTLING=True

# PostgreSQL (use long alphanumeric values to avoid URL/shell escaping issues)
POSTGRES_DB=toya_db
POSTGRES_USER=toya
POSTGRES_PASSWORD=generate_a_unique_database_password
DB_NAME=toya_db
DB_USER=toya
DB_PASSWORD=generate_a_unique_database_password
DB_HOST=postgres
DB_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=generate_a_unique_redis_password

# Firebase service account is mounted by Docker Compose.
FIREBASE_CREDENTIALS=/run/secrets/firebase-service-account.json

# Application integrations
GOOGLE_API_KEY=
SMS_USER=
SMS_PASSWORD=
SMS_SENDER_ID=TOYA
S3P_KEY=
S3P_SECRET=
BASE_API_URL=https://s3pv2cm.smobilpay.com/v2/
S3P_KEY_DEV=
S3P_SECRET_DEV=
BASE_API_URL_DEV=https://s3p.smobilpay.staging.maviance.info/v2/
SMOBIL_PAY_API_DEBUG=False

# SMTP
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
